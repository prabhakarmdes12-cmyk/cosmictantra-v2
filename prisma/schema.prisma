generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OnboardingStatus {
  INVITED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum AstrologySpecialty {
  KUNDALI
  MARRIAGE
  CAREER
  BUSINESS
  REMEDIES
  VASTU
  SPIRITUAL
  PANCHANG
  NUMEROLOGY
  OTHER
}

enum ConsultationStatus {
  DRAFT
  PAYMENT_PENDING
  PAID
  CALCULATING
  AI_DRAFT_READY
  ASSIGNED
  PANDIT_REVIEW
  APPROVED
  DELIVERY_READY
  DELIVERED
  CALCULATION_FAILED
  AI_FAILED
  REVIEW_REJECTED
  DELIVERY_FAILED
  REFUNDED
}

model AstrologyPractitionerInvite {
  id           String    @id @default(uuid())
  token        String    @unique
  projectId    String    @default("cosmic-tantra")
  name         String
  phone        String
  email        String?
  languages    String[]  @default(["Hindi", "English"])
  internalNote String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([token])
  @@index([phone])
}

model AstrologyConsultant {
  id                   String             @id @default(uuid())
  publicId             String?            @default(uuid())
  projectId            String             @default("cosmic-tantra")
  name                 String?            // Legacy field
  photo                String?            // Legacy field
  fullName             String             @default("Pandit Ji")
  displayName          String             @default("Pandit Ji")
  phone                String             @default("")
  email                String?
  city                 String             @default("Varanasi")
  state                String             @default("Uttar Pradesh")
  languages            String[]           @default(["Hindi", "English"])
  expertise            String[]           @default(["Kundali"])
  yearsExperience      Int                @default(0)
  experience           String?            // Legacy field
  location             String?            // Legacy field
  bio                  String?            // Legacy field
  biography            String?
  tradition            String?
  qualifications       String?
  profilePhoto         String?            @default("🧙")
  specialty            AstrologySpecialty @default(KUNDALI)
  pricePerSession      Int                @default(199)
  durationMinutes      Int                @default(30)
  badges               String[]           @default(["Verified Practitioner"])
  rating               Float              @default(5.0)
  reviewCount          Int                @default(0)
  isVerified           Boolean            @default(true)
  onboardingStatus     OnboardingStatus   @default(COMPLETED)
  isActive             Boolean            @default(true)
  aiReviewConsent      Boolean            @default(true)
  videoContentInterest Boolean            @default(false)
  onboardedAt          DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  auditLogs     AstrologyAuditLog[]
  consultations AstrologyConsultation[]

  @@index([projectId])
  @@index([phone])
  @@index([onboardingStatus])
}

model AstrologyConsultation {
  id                   String             @id @default(uuid())
  publicId             String             @unique @default(uuid())
  projectId            String             @default("cosmic-tantra")
  practitionerId       String?
  isTestCase           Boolean            @default(false)
  orderType            String             @default("STANDARD_PAID") // STANDARD_PAID, INTERNAL_TEST
  status               ConsultationStatus @default(DRAFT)
  
  // Customer Inputs
  customerName         String
  customerPhone        String?
  customerEmail        String?
  customerQuestion     String
  birthDate            DateTime
  birthTime            String             @default("10:30")
  birthCity            String             @default("Patna")
  birthLat             Float              @default(25.5941)
  birthLon             Float              @default(85.1376)
  timezone             Float              @default(5.5)

  // Immutable Calculation Output
  calculationSnapshot  Json?
  calculationVersion   String?            @default("v34")

  // AI Working Draft Output
  aiDraft              String?
  aiModel              String?            @default("claude-sonnet-4-20250514")
  promptVersion        String?            @default("v34")

  // Human Practitioner Verified Output
  practitionerFinal    String?
  practitionerNotes    String?
  approvedBy           String?
  approvedAt           DateTime?

  // Payment & Delivery
  paymentProvider      String?            @default("INTERNAL_TEST")
  paymentStatus        String             @default("PENDING")
  amount               Int                @default(199)
  deliveryChannel      String?            @default("WHATSAPP")
  deliveredAt          DateTime?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  customerProfileId    String?
  customerProfile      AstrologyCustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  practitioner         AstrologyConsultant?      @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  auditLogs            AstrologyAuditLog[]

  @@index([projectId, status])
  @@index([practitionerId])
  @@index([customerProfileId])
  @@index([isTestCase])
}

model AstrologyAuditLog {
  id             String   @id @default(uuid())
  practitionerId String?
  consultationId String?
  eventType      String
  actorType      String   @default("SYSTEM") // ADMIN, PANDIT, SYSTEM, CUSTOMER
  payload        Json?
  createdAt      DateTime @default(now())

  practitioner   AstrologyConsultant?   @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  consultation   AstrologyConsultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([practitionerId])
  @@index([consultationId])
  @@index([eventType])
}

// Phase 2: Customer Profile + Family + OTP + DPDP (WhatsApp primary identity)
model AstrologyCustomerProfile {
  id                String    @id @default(uuid())
  projectId         String    @default("cosmic-tantra")
  // Primary identity (WhatsApp number is canonical for India audience)
  whatsappPhone     String    @unique
  email             String?
  fullName          String?
  // DPDP compliance fields
  consentGiven      Boolean   @default(false)
  consentAt         DateTime?
  consentVersion    String?   @default("v1-dpdp-2023")
  dataRetentionDays Int?      @default(365) // configurable per user
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  // OTP sync / verification
  lastOtpVerifiedAt DateTime?
  otpVerified       Boolean   @default(false)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  familyMembers     AstrologyFamilyMember[]
  consultations     AstrologyConsultation[] // link via phone if needed

  @@index([projectId])
  @@index([whatsappPhone])
  @@index([isDeleted])
}

model AstrologyFamilyMember {
  id             String    @id @default(uuid())
  profileId      String
  name           String
  birthDate      DateTime?
  birthTime      String?   @default("10:30")
  birthCity      String?   @default("Patna")
  birthLat       Float?
  birthLon       Float?
  relation       String    @default("SELF") // SELF, SPOUSE, CHILD, PARENT, SIBLING, OTHER
  gender         String?   // MALE, FEMALE, OTHER
  // DPDP minor flag
  isMinor        Boolean   @default(false)
  guardianConsent Boolean  @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile        AstrologyCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([relation])
}

model OtpVerification {
  id          String   @id @default(uuid())
  phone       String
  otpHash     String   // never store plain OTP
  purpose     String   @default("PROFILE_VERIFY") // PROFILE_VERIFY, CONSULTATION, DELIVERY_CONFIRM
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phone])
  @@index([purpose])
  @@index([expiresAt])
}
