generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OnboardingStatus {
  INVITED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum AstrologySpecialty {
  KUNDALI
  MARRIAGE
  CAREER
  BUSINESS
  REMEDIES
  VASTU
  SPIRITUAL
  PANCHANG
  NUMEROLOGY
  OTHER
}

enum ConsultationStatus {
  NEW
  INTAKE_IN_PROGRESS
  INTAKE_COMPLETE
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  SCHOLAR_ASSIGNMENT_PENDING
  SCHOLAR_ASSIGNED
  CALLBACK_PENDING
  CONNECTED
  IN_CONSULTATION
  COMPLETED
  // Failure / Exceptional states
  PAYMENT_FAILED
  CUSTOMER_UNREACHABLE
  SCHOLAR_UNAVAILABLE
  CANCELLED
  REFUND_PENDING
  REFUNDED
  ESCALATED
  // Legacy backward compatibility
  DRAFT
  PAID
  CALCULATING
  AI_DRAFT_READY
  ASSIGNED
  PANDIT_REVIEW
  APPROVED
  DELIVERY_READY
  DELIVERED
  CALCULATION_FAILED
  AI_FAILED
  REVIEW_REJECTED
  DELIVERY_FAILED
}

model AstrologyPractitionerInvite {
  id           String    @id @default(uuid())
  token        String    @unique
  projectId    String    @default("cosmic-tantra")
  name         String
  phone        String
  email        String?
  languages    String[]  @default(["Hindi", "English"])
  internalNote String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([token])
  @@index([phone])
}

model AstrologyConsultant {
  id                   String             @id @default(uuid())
  publicId             String?            @default(uuid())
  projectId            String             @default("cosmic-tantra")
  name                 String? // Legacy field
  photo                String? // Legacy field
  fullName             String             @default("Pandit Ji")
  displayName          String             @default("Pandit Ji")
  phone                String             @default("")
  email                String?
  city                 String             @default("Varanasi")
  state                String             @default("Uttar Pradesh")
  languages            String[]           @default(["Hindi", "English"])
  expertise            String[]           @default(["Kundali"])
  yearsExperience      Int                @default(0)
  experience           String? // Legacy field
  location             String? // Legacy field
  bio                  String? // Legacy field
  biography            String?
  tradition            String?
  qualifications       String?
  profilePhoto         String?            @default("🧙")
  specialty            AstrologySpecialty @default(KUNDALI)
  pricePerSession      Int                @default(501)
  durationMinutes      Int                @default(30)
  badges               String[]           @default(["Verified Practitioner"])
  rating               Float              @default(5.0)
  reviewCount          Int                @default(0)
  isVerified           Boolean            @default(true)
  isTestFixture        Boolean            @default(false)
  onboardingStatus     OnboardingStatus   @default(COMPLETED)
  isActive             Boolean            @default(true)
  aiReviewConsent      Boolean            @default(true)
  videoContentInterest Boolean            @default(false)
  onboardedAt          DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  auditLogs     AstrologyAuditLog[]
  consultations AstrologyConsultation[]

  @@index([projectId])
  @@index([phone])
  @@index([onboardingStatus])
  @@index([isTestFixture])
}

model AstrologyConsultation {
  id             String             @id @default(uuid())
  publicId       String             @unique @default(uuid())
  projectId      String             @default("cosmic-tantra")
  practitionerId String?
  isTestCase     Boolean            @default(false)
  orderType      String             @default("STANDARD_PAID") // STANDARD_PAID, INTERNAL_TEST
  status         ConsultationStatus @default(DRAFT)

  // Customer Inputs
  customerName     String
  customerPhone    String?
  customerEmail    String?
  customerQuestion String
  birthDate        DateTime
  birthTime        String   @default("10:30")
  birthCity        String   @default("Patna")
  birthLat         Float    @default(25.5941)
  birthLon         Float    @default(85.1376)
  timezone         Float    @default(5.5)

  // Immutable Calculation Output
  calculationSnapshot Json?
  calculationVersion  String? @default("v34")

  // AI Working Draft Output
  aiDraft       String?
  aiModel       String? @default("claude-sonnet-4-20250514")
  promptVersion String? @default("v34")

  // Human Practitioner Verified Output
  practitionerFinal String?
  practitionerNotes String?
  approvedBy        String?
  approvedAt        DateTime?

  // Caller vs Subject separation
  callerPhone         String?
  callerName          String?
  relationship        String? @default("SELF")
  birthTimeConfidence String? @default("EXACT") // EXACT, APPROXIMATE, UNKNOWN

  // Consultation Lifecycle Timing & Notes
  connectedAt        DateTime?
  completedAt        DateTime?
  sessionDurationSec Int?      @default(0)
  consultationNotes  Json? // 4 Quadrants (calculatedAstrology, scholarInterpretation, userReportedFact, traditionalRemedy)
  cancellationReason String?

  // Payment & Delivery
  paymentProvider String?   @default("INTERNAL_TEST")
  paymentStatus   String    @default("PENDING")
  amount          Int       @default(501)
  deliveryChannel String?   @default("WHATSAPP")
  deliveredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfileId String?
  customerProfile   AstrologyCustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  practitioner      AstrologyConsultant?      @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  auditLogs         AstrologyAuditLog[]

  @@index([projectId, status])
  @@index([practitionerId])
  @@index([customerProfileId])
  @@index([isTestCase])
}

model AstrologyAuditLog {
  id             String   @id @default(uuid())
  practitionerId String?
  consultationId String?
  eventType      String
  actorType      String   @default("SYSTEM") // ADMIN, PANDIT, SYSTEM, CUSTOMER
  payload        Json?
  createdAt      DateTime @default(now())

  practitioner AstrologyConsultant?   @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  consultation AstrologyConsultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([practitionerId])
  @@index([consultationId])
  @@index([eventType])
}

// Phase 2: Customer Profile + Family + OTP + DPDP (WhatsApp primary identity)
model AstrologyCustomerProfile {
  id                String    @id @default(uuid())
  projectId         String    @default("cosmic-tantra")
  // Primary identity (WhatsApp number is canonical for India audience)
  whatsappPhone     String    @unique
  email             String?
  fullName          String?
  // DPDP compliance fields
  consentGiven      Boolean   @default(false)
  consentAt         DateTime?
  consentVersion    String?   @default("v1-dpdp-2023")
  dataRetentionDays Int?      @default(365) // configurable per user
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  // OTP sync / verification
  lastOtpVerifiedAt DateTime?
  otpVerified       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyMembers AstrologyFamilyMember[]
  consultations AstrologyConsultation[] // link via phone if needed

  @@index([projectId])
  @@index([whatsappPhone])
  @@index([isDeleted])
}

model AstrologyFamilyMember {
  id              String    @id @default(uuid())
  profileId       String
  name            String
  birthDate       DateTime?
  birthTime       String?   @default("10:30")
  birthCity       String?   @default("Patna")
  birthLat        Float?
  birthLon        Float?
  relation        String    @default("SELF") // SELF, SPOUSE, CHILD, PARENT, SIBLING, OTHER
  gender          String? // MALE, FEMALE, OTHER
  // DPDP minor flag
  isMinor         Boolean   @default(false)
  guardianConsent Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile AstrologyCustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([relation])
}

model OtpVerification {
  id         String    @id @default(uuid())
  phone      String
  otpHash    String // never store plain OTP
  purpose    String    @default("PROFILE_VERIFY") // PROFILE_VERIFY, CONSULTATION, DELIVERY_CONFIRM
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([purpose])
  @@index([expiresAt])
}

// Canonical Dynamic Service Catalog Model
model AstrologyService {
  id              String   @id @default(uuid())
  code            String   @unique // e.g. "CONSULT_15", "CONSULT_30"
  name            String
  durationMinutes Int
  priceInr        Int
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

// ============================================================================
// PJOS-01 DOMAIN (Decision D-1): server-side identity & access.
// Account != Person. One account may contain Me / Child / Parent / Partner /
// Client — the account is NOT the person. Auth transport is replaceable
// (PHONE_OTP / EMAIL / GOOGLE) without changing Person ownership.
// Ownership invariant: every server-side object resolves
//   resource -> personId -> authorized account relationship OR
//   professional access grant
// BEFORE any read or mutation. See src/lib/pjos/ownershipGuard.ts.
// ============================================================================

enum PjosAuthChannel {
  PHONE_OTP
  EMAIL
  GOOGLE
}

enum PjosSensitivity {
  ACCOUNT_PRIVATE
  PERSONAL_ASTROLOGY
  CONSULTATION_CONFIDENTIAL
  PANDIT_INTERNAL
}

enum PjosRelationshipType {
  SELF
  GUARDIAN_MANAGED // minor, managed by a guardian account
  WITH_CONSENT // another adult who consented to being in this account
  IMPORTED_FOR_PRIVATE_ANALYSIS
  PANDIT_CLIENT
}

enum PjosGrantScope {
  READ
  WRITE
  CONSULT
  MANAGE
}

enum PjosConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

model PjosAccount {
  id        String  @id @default(uuid())
  projectId String  @default("cosmic-tantra")
  displayName String?
  isActive  Boolean @default(true)

  // Credentials live in PjosAuthIdentity, NOT here. The original shape put
  // authChannel+authSubject on the account under a composite unique, which
  // made "the credential channel never owns the Person" true in the comment
  // and false in the schema: one human signing in by phone and later by email
  // became two accounts holding two copies of the same Person, and nothing
  // could ever put them back together. One account, many ways to prove you
  // are it.
  identities PjosAuthIdentity[]

  // Set when this account loses a merge. It is never deleted: consent records
  // and audit rows point at it, and a merge must not rewrite history.
  mergedIntoId String?
  mergedInto   PjosAccount?  @relation("AccountMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   PjosAccount[] @relation("AccountMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationships PjosPersonRelationship[]
  grantsGranted PjosAccessGrant[]        @relation("GrantedBy")
  consents      PjosConsentRecord[]
  claimedSessions PjosAnonymousSession[]
  mergesAsSurvivor PjosAccountMerge[]    @relation("MergeSurvivor")
  mergesAsAbsorbed PjosAccountMerge[]    @relation("MergeAbsorbed")

  @@index([projectId])
  @@index([mergedIntoId])
}

/// One way of proving you are an account. A human may hold several.
///
/// The unique key is (channel, subject) GLOBALLY, so a phone number can only
/// ever point at one account — that is what makes a merge detectable instead
/// of silently forking the user.
model PjosAuthIdentity {
  id        String          @id @default(uuid())
  accountId String
  channel   PjosAuthChannel
  subject   String // phone (E.164) / email (lowercased) / provider subject id

  // A channel is only allowed to merge accounts once it has been proven.
  verifiedAt DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  account PjosAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([channel, subject])
  @@index([accountId])
}

/// Audit of a merge. Append-only, like consent.
///
/// Merging re-points the mutable associations (identities, relationships,
/// grants) but deliberately leaves PjosConsentRecord rows attached to the
/// account that actually gave the consent. A consent is a historical fact
/// about a credential-holder at a moment in time; rewriting whose it was to
/// tidy up a merge would be falsifying the DPDP record. These rows are how a
/// reader walks from the old account to the surviving one.
model PjosAccountMerge {
  id                 String   @id @default(uuid())
  survivingAccountId String
  absorbedAccountId  String
  /// What triggered it, e.g. "LINK_CHANNEL:EMAIL".
  reason             String
  personsMoved       Int      @default(0)
  identitiesMoved    Int      @default(0)
  mergedAt           DateTime @default(now())

  surviving PjosAccount @relation("MergeSurvivor", fields: [survivingAccountId], references: [id], onDelete: Cascade)
  absorbed  PjosAccount @relation("MergeAbsorbed", fields: [absorbedAccountId], references: [id], onDelete: Cascade)

  @@index([survivingAccountId])
  @@unique([absorbedAccountId])
}

/// A chart entered before anyone signed in.
///
/// Asking for a phone number before showing the Kundli is the single biggest
/// drop-off in this funnel, so the Person is created on birth-detail entry and
/// held against a signed device cookie. Claiming it later attaches it to a real
/// account without the user re-typing anything — and an abandoned funnel still
/// leaves a recoverable chart instead of nothing.
model PjosAnonymousSession {
  id        String   @id @default(uuid())
  projectId String   @default("cosmic-tantra")
  /// SHA-256 of the cookie value. The raw token is never stored.
  tokenHash String   @unique
  personId  String?
  person    PjosPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)

  claimedByAccountId String?
  claimedBy          PjosAccount? @relation(fields: [claimedByAccountId], references: [id], onDelete: SetNull)
  claimedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([personId])
  @@index([claimedByAccountId])
  @@index([expiresAt])
}

model PjosPerson {
  id          String    @id @default(uuid())
  projectId   String    @default("cosmic-tantra")
  displayName String
  birthDate   DateTime?
  birthTime   String? // HH:mm — timeConfidence semantics live on the kundli record
  birthPlace  String?
  birthLat    Float?
  birthLon    Float?
  isMinor     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  relationships PjosPersonRelationship[]
  accessGrants  PjosAccessGrant[]
  consents      PjosConsentRecord[]
  anonymousSessions PjosAnonymousSession[]

  @@index([projectId])
}

model PjosPersonRelationship {
  id           String               @id @default(uuid())
  accountId    String
  personId     String
  relationType PjosRelationshipType
  guardianRole String? // for GUARDIAN_MANAGED: FATHER / MOTHER / ...
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  account PjosAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  person  PjosPerson  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([accountId, personId])
  @@index([personId])
}

model PjosAccessGrant {
  id                    String          @id @default(uuid())
  personId              String
  granteeAccountId      String? // family/professional-account grantee
  granteePractitionerId String? // professional (practitioner) grantee
  scope                 PjosGrantScope
  sensitivity           PjosSensitivity
  grantedById           String? // account that created the grant
  grantedAt             DateTime        @default(now())
  expiresAt             DateTime?
  revokedAt             DateTime?

  person    PjosPerson   @relation(fields: [personId], references: [id], onDelete: Cascade)
  grantedBy PjosAccount? @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([granteeAccountId])
  @@index([granteePractitionerId])
}

model PjosConsentRecord {
  id          String            @id @default(uuid())
  personId    String
  accountId   String? // null => consent given in a professional context
  sensitivity PjosSensitivity
  status      PjosConsentStatus @default(GRANTED)
  purpose     String
  version     String            @default("v1")
  grantedAt   DateTime          @default(now())
  revokedAt   DateTime?

  person  PjosPerson   @relation(fields: [personId], references: [id], onDelete: Cascade)
  givenBy PjosAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Append-only: consent is never edited; revocation is a REVOKED record
  // referencing the same purpose+version.
  @@index([personId, status])
  @@index([accountId])
}

// ============================================================================
// CHITIGRAM v0.2 — Operational Pilot Domain (Canonical, Organisation-scoped)
// ============================================================================

enum ChitigramConversationState {
  CREATED
  WAITING
  ASSIGNED
  RINGING
  ACCEPTED
  LIVE
  ENDED
  FOLLOW_UP
  CLOSED
  DECLINED
  NO_ANSWER
  CANCELLED
  FAILED
  REASSIGNED
}

enum ChitigramMessageType {
  TEXT
  SYSTEM
  CONTEXT
  ACTION
  PAYMENT
  CALL
  VOICE
  FILE
}

enum ChitigramMessageStatus {
  SENT
  DELIVERED
  READ
}

enum ChitigramVisibility {
  VISIBLE
  INTERNAL
}

enum ChitigramConnectionState {
  ONLINE
  AWAY
  OFFLINE
}

enum ChitigramAvailability {
  AVAILABLE
  BUSY
  DND
  OFF_DUTY
}

model ChitigramConversation {
  id               String                      @id // stable conversationId, also sessionId alias stored in sessionId field
  organizationId   String                      @default("cosmic-tantra")
  domain           String                      @default("cosmic-tantra") // cosmic-tantra | hms | bazaarsetu
  sessionId        String?                     @unique // backward compat: consultation sessionId alias
  // Seeker context
  seekerName       String?
  seekerPhoneMasked String?
  seekerUserId     String?
  language         String                      @default("Hindi")
  category         String                      @default("General Guidance")
  originalQuestion String?
  // Kundli/report reference
  kundliRef        String?
  kundliSummary    Json?
  // Payment truth — only backend verification may set PAID/VERIFIED
  paymentStatus    String                      @default("PENDING") // PENDING | VERIFIED | PAID | FAILED
  paymentAmountInr Int                         @default(0)
  paymentTransactionId String?
  paymentReferenceId String?
  paymentVerifiedAt DateTime?
  paymentVerifiedBy String?
  // Lifecycle state — server-authoritative, transitions validated
  state            ChitigramConversationState  @default(CREATED)
  // Assignment — operator manually assigns Pandit
  assignedPractitionerId String?
  assignedPractitionerName String?
  assignedBy       String?
  assignedAt       DateTime?
  assignmentAcceptance String?                 // PENDING | ACCEPTED | DECLINED
  // Waiting / queue tracking
  waitingSince     DateTime?                   @default(now())
  lastActivityAt   DateTime                    @updatedAt
  closedAt         DateTime?
  // Waiting time computed via waitingSince -> now if WAITING
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  participants     ChitigramParticipant[]
  messages         ChitigramMessage[]
  calls            ChitigramCall[]
  assignments      ChitigramAssignment[]
  auditEvents      ChitigramAuditEvent[]

  @@index([organizationId, domain])
  @@index([state])
  @@index([assignedPractitionerId])
  @@index([paymentStatus])
  @@index([waitingSince])
  @@index([sessionId])
}

model ChitigramParticipant {
  id               String   @id @default(uuid())
  organizationId   String   @default("cosmic-tantra")
  domain           String   @default("cosmic-tantra")
  conversationId   String
  userId           String
  role             String   // devotee | pandit | operator | system
  displayName      String?
  // Membership capabilities — denormalized for quick checks, authoritative via ChitigramCapabilities
  capabilities     String[] @default([])
  joinedAt         DateTime @default(now())
  lastReadMessageId String?
  lastSeenAt       DateTime @default(now())
  isActive         Boolean  @default(true)

  conversation     ChitigramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@index([role])
}

model ChitigramMessage {
  id               String                @id // stable messageId (server-assigned)
  organizationId   String                @default("cosmic-tantra")
  domain           String                @default("cosmic-tantra")
  conversationId   String
  clientMessageId  String?               @unique // idempotent POST — client-provided
  sequence         Int                   // per-conversation strictly increasing
  senderId         String?
  senderRole       String                // devotee | pandit | operator | system
  senderName       String?
  type             ChitigramMessageType  @default(TEXT)
  subType          String?               // ASTROLOGY.KUNDLI_INSIGHT | ASTROLOGY.DAKSHINA | legacy KUNDLI_INSIGHT etc
  text             String?
  // Legacy compat fields — mapped from new protocol
  cardType         String?
  cardPayload      Json?
  payload          Json?                 // generic extensible payload (voice metadata, file refs, context, etc.)
  visibility       ChitigramVisibility   @default(VISIBLE) // VISIBLE vs INTERNAL — CHITI TEAM ONLY
  status           ChitigramMessageStatus @default(SENT)
  // Server timestamps — authoritative
  createdAt        DateTime              @default(now()) // server timestamp
  updatedAt        DateTime              @updatedAt
  // Delivery/read tracking
  deliveredAt      DateTime?
  readAt           DateTime?

  conversation     ChitigramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequence])
  @@index([clientMessageId])
  @@index([senderId])
  @@index([visibility])
  @@index([createdAt])
}

model ChitigramCall {
  id               String   @id @default(uuid())
  organizationId   String   @default("cosmic-tantra")
  domain           String   @default("cosmic-tantra")
  conversationId   String
  roomId           String?
  callerId         String
  callerRole       String
  recipientIds     String[] // all intended recipients (devotee, pandit, operator)
  // Timestamps — server authoritative
  createdAt        DateTime @default(now())
  ringingAt        DateTime?
  acceptedAt       DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  durationSeconds  Int?
  outcome          String?  // COMPLETED | NO_ANSWER | DECLINED | FAILED | CANCELLED | MISSED
  failureReason    String?
  // Warm transfer support — multi-participant
  isWarmTransfer   Boolean  @default(false)
  transferredBy    String?
  transferredAt    DateTime?
  holdState        String?  // NONE | HOLD | RESUMED

  conversation     ChitigramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([callerId])
  @@index([outcome])
  @@index([startedAt])
}

model ChitigramAssignment {
  id               String   @id @default(uuid())
  organizationId   String   @default("cosmic-tantra")
  domain           String   @default("cosmic-tantra")
  conversationId   String
  practitionerId   String
  practitionerName String?
  assignedBy       String
  assignedAt       DateTime @default(now())
  acceptanceState  String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  acceptedAt       DateTime?
  declinedReason   String?
  isActive         Boolean  @default(true)

  conversation     ChitigramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([practitionerId])
  @@index([assignedBy])
  @@index([acceptanceState])
}

model ChitigramPresence {
  id               String                    @id @default(uuid())
  organizationId   String                    @default("cosmic-tantra")
  domain           String                    @default("cosmic-tantra")
  userId           String                    @unique
  userRole         String                    @default("operator") // devotee | pandit | operator
  displayName      String?
  connectionState  ChitigramConnectionState  @default(OFFLINE) // ONLINE | AWAY | OFFLINE — backed by server heartbeat
  availability     ChitigramAvailability     @default(OFF_DUTY) // AVAILABLE | BUSY | DND | OFF_DUTY — for practitioners
  lastSeenAt       DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([connectionState])
  @@index([availability])
  @@index([userRole])
}

model ChitigramAuditEvent {
  id               String   @id @default(uuid())
  organizationId   String   @default("cosmic-tantra")
  domain           String   @default("cosmic-tantra")
  conversationId   String
  actorId          String?
  actorRole        String?
  eventType        String   // CONVERSATION_CREATED | PAYMENT_VERIFIED | ASSIGNED | ACCEPTED | CALL_STARTED | CALL_ENDED | NOTE_ADDED | FOLLOW_UP | CLOSED | REASSIGNED | TRANSFER | HOLD etc
  fromState        String?
  toState          String?
  details          Json?
  createdAt        DateTime @default(now())

  conversation     ChitigramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([eventType])
  @@index([actorId])
  @@index([createdAt])
}

model ChitigramNotification {
  id               String   @id @default(uuid())
  organizationId   String   @default("cosmic-tantra")
  domain           String   @default("cosmic-tantra")
  userId           String
  conversationId   String
  type             String   // MESSAGE | CALL | ASSIGNMENT | TRANSFER | FOLLOW_UP
  title            String
  body             String?  // minimal safe info only
  link             String?  // e.g. /consultation/room/[id] or /chitigram/inbox?conversationId=...
  read             Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId, read])
  @@index([conversationId])
  @@index([type])
}
